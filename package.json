{
  "name": "@xiaonerner0821/dsh-hanmo",
  "version": "1.1.4",
  "description": "Hanmo (翰墨): an appearance plugin for the DeepSeek Harness Web UI — glowing outlined sidebar tiles, a comet-trace New Session button, six VS Code colour themes plus a sunset-sky theme, registered with DSH's theme service, font and text-colour controls, and a highlighted main-panel file preview.",
  "type": "module",
  "license": "MIT",
  "author": "xiaonerner0821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaonerner0821/dsh-hanmo.git"
  },
  "homepage": "https://github.com/xiaonerner0821/dsh-hanmo#readme",
  "bugs": {
    "url": "https://github.com/xiaonerner0821/dsh-hanmo/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "sidebar",
    "fonts",
    "ui"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.editor.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "docs/theme-cards.png",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "build:fonts": "node build-fonts.mjs",
    "build:editor": "node editor/build.mjs @xiaonerner0821/dsh-hanmo client.editor.js",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.25.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "^0.2.1-rc.1",
    "node": ">=20"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
